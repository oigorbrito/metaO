  "scenarios": [
    {
      "fixture_id": "isolated-failure-then-successes",
      "sequence": 1,
      "runtime": {"id": "runtime-a", "version": "1.0.0", "config_id": "cfg-a"},
      "prior_state": "HEALTHY",
      "observation": {"attempts": 4, "successes": 3, "failures": 1, "consecutive_failures": 0, "timeouts": 0, "transport_failures": 0, "active_retries": 0, "fresh_successes_since_unhealthy": 0, "self_reported_healthy": null},
      "policy": {"quarantine_consecutive_failures": 3, "unhealthy_failure_percent": 75, "recovery_successes_required": 2, "retry_pressure_limit": 2},
      "expected_state": "DEGRADED",
      "expected_retry_pressure_exceeded": false,
      "rationale": "One isolated failure remains visible but does not create permanent quarantine."
    },
    {
      "fixture_id": "repeated-failures-cross-quarantine-threshold",
      "sequence": 2,
      "runtime": {"id": "runtime-a", "version": "1.0.0", "config_id": "cfg-a"},
      "prior_state": "DEGRADED",
      "observation": {"attempts": 3, "successes": 0, "failures": 3, "consecutive_failures": 3, "timeouts": 1, "transport_failures": 1, "active_retries": 0, "fresh_successes_since_unhealthy": 0, "self_reported_healthy": false},
      "policy": {"quarantine_consecutive_failures": 3, "unhealthy_failure_percent": 75, "recovery_successes_required": 2, "retry_pressure_limit": 2},
      "expected_state": "QUARANTINED",
      "expected_retry_pressure_exceeded": false,
      "rationale": "Explicit caller-configured consecutive failure threshold is crossed."
    },
    {
      "fixture_id": "alternating-flapping-preserves-degraded-history",
      "sequence": 3,
      "runtime": {"id": "runtime-a", "version": "1.0.0", "config_id": "cfg-a"},
      "prior_state": "DEGRADED",
      "observation": {"attempts": 6, "successes": 3, "failures": 3, "consecutive_failures": 1, "timeouts": 0, "transport_failures": 0, "active_retries": 1, "fresh_successes_since_unhealthy": 0, "self_reported_healthy": true},
      "policy": {"quarantine_consecutive_failures": 3, "unhealthy_failure_percent": 80, "recovery_successes_required": 2, "retry_pressure_limit": 2},
      "expected_state": "DEGRADED",
      "expected_retry_pressure_exceeded": false,
      "rationale": "Alternating success/failure does not silently reset factual failure history to healthy."
    },
    {
      "fixture_id": "retry-pressure-over-limit",
      "sequence": 4,
      "runtime": {"id": "runtime-a", "version": "1.0.0", "config_id": "cfg-a"},
      "prior_state": "UNHEALTHY",
      "observation": {"attempts": 5, "successes": 2, "failures": 3, "consecutive_failures": 1, "timeouts": 1, "transport_failures": 0, "active_retries": 3, "fresh_successes_since_unhealthy": 1, "self_reported_healthy": null},
      "policy": {"quarantine_consecutive_failures": 4, "unhealthy_failure_percent": 80, "recovery_successes_required": 2, "retry_pressure_limit": 2},
      "expected_state": "RECOVERING",
      "expected_retry_pressure_exceeded": true,
      "rationale": "Retry pressure is a factual projection input and does not itself dispatch or fail over."
    },
    {
      "fixture_id": "lying-self-report-cannot-override-failures",
      "sequence": 5,
      "runtime": {"id": "runtime-a", "version": "1.0.0", "config_id": "cfg-a"},
      "prior_state": "HEALTHY",
      "observation": {"attempts": 4, "successes": 0, "failures": 4, "consecutive_failures": 2, "timeouts": 0, "transport_failures": 1, "active_retries": 0, "fresh_successes_since_unhealthy": 0, "self_reported_healthy": true},
      "policy": {"quarantine_consecutive_failures": 3, "unhealthy_failure_percent": 75, "recovery_successes_required": 2, "retry_pressure_limit": 2},
      "expected_state": "UNHEALTHY",
      "expected_retry_pressure_exceeded": false,
      "rationale": "Runtime self-report is observation only and cannot override factual outcomes."
    },
    {
      "fixture_id": "failover-b-does-not-reset-a-history",
      "sequence": 6,
      "runtime": {"id": "runtime-a", "version": "1.0.0", "config_id": "cfg-a"},
      "failover_target": {"id": "runtime-b", "version": "2.0.0", "config_id": "cfg-b"},
      "prior_state": "QUARANTINED",
      "observation": {"attempts": 5, "successes": 1, "failures": 4, "consecutive_failures": 4, "timeouts": 1, "transport_failures": 1, "active_retries": 0, "fresh_successes_since_unhealthy": 0, "self_reported_healthy": null},
      "policy": {"quarantine_consecutive_failures": 3, "unhealthy_failure_percent": 75, "recovery_successes_required": 2, "retry_pressure_limit": 2},
      "expected_state": "QUARANTINED",
      "expected_retry_pressure_exceeded": false,
      "rationale": "Selecting another runtime does not erase the unhealthy history bound to runtime A."
