    {
      "fixture_id": "fresh-successes-required-for-recovery",
      "sequence": 7,
      "runtime": {"id": "runtime-a", "version": "1.0.0", "config_id": "cfg-a"},
      "prior_state": "QUARANTINED",
      "observation": {"attempts": 2, "successes": 2, "failures": 0, "consecutive_failures": 0, "timeouts": 0, "transport_failures": 0, "active_retries": 0, "fresh_successes_since_unhealthy": 1, "self_reported_healthy": true},
      "policy": {"quarantine_consecutive_failures": 3, "unhealthy_failure_percent": 75, "recovery_successes_required": 2, "retry_pressure_limit": 2},
      "expected_state": "RECOVERING",
      "expected_retry_pressure_exceeded": false,
      "rationale": "One fresh success is insufficient when policy requires two."
    },
    {
      "fixture_id": "zero-retry-pressure-limit-is-strict-valid-policy",
      "sequence": 8,
      "runtime": {"id": "runtime-a", "version": "1.0.0", "config_id": "cfg-a"},
      "prior_state": "HEALTHY",
      "observation": {"attempts": 1, "successes": 1, "failures": 0, "consecutive_failures": 0, "timeouts": 0, "transport_failures": 0, "active_retries": 1, "fresh_successes_since_unhealthy": 0, "self_reported_healthy": null},
      "policy": {"quarantine_consecutive_failures": 3, "unhealthy_failure_percent": 75, "recovery_successes_required": 2, "retry_pressure_limit": 0},
      "expected_state": "DEGRADED",
      "expected_retry_pressure_exceeded": true,
      "rationale": "Zero means no concurrent retry pressure is allowed; it is not invalid configuration."
    },
    {
      "fixture_id": "config-mutation-creates-distinct-health-scope",
      "sequence": 9,
      "runtime": {"id": "runtime-a", "version": "1.0.0", "config_id": "cfg-new"},
      "previous_scope": {"id": "runtime-a", "version": "1.0.0", "config_id": "cfg-old"},
      "prior_state": "UNKNOWN",
      "observation": {"attempts": 1, "successes": 1, "failures": 0, "consecutive_failures": 0, "timeouts": 0, "transport_failures": 0, "active_retries": 0, "fresh_successes_since_unhealthy": 0, "self_reported_healthy": null},
      "policy": {"quarantine_consecutive_failures": 3, "unhealthy_failure_percent": 75, "recovery_successes_required": 2, "retry_pressure_limit": 2},
      "expected_state": "HEALTHY",
      "expected_retry_pressure_exceeded": false,
      "rationale": "Material config identity change creates a distinct observation scope rather than inheriting prior state silently."
    },
    {
      "fixture_id": "empty-window-remains-unknown",
      "sequence": 10,
      "runtime": {"id": "runtime-c", "version": "1.0.0", "config_id": "cfg-c"},
      "prior_state": "UNKNOWN",
      "observation": {"attempts": 0, "successes": 0, "failures": 0, "consecutive_failures": 0, "timeouts": 0, "transport_failures": 0, "active_retries": 0, "fresh_successes_since_unhealthy": 0, "self_reported_healthy": true},
      "policy": {"quarantine_consecutive_failures": 3, "unhealthy_failure_percent": 75, "recovery_successes_required": 2, "retry_pressure_limit": 2},
      "expected_state": "UNKNOWN",
      "expected_retry_pressure_exceeded": false,
      "rationale": "No factual attempts means UNKNOWN even when the runtime self-reports healthy."
